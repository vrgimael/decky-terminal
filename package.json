{
  "name": "decky-terminal-focus",
  "version": "0.5.3-focus.1",
  "type": "module",
  "description": "Decky terminal with captured input, virtual-keyboard restoration, and reliable fullscreen controls.",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "local-deploy": "./.vscode/deploy.sh",
    "build-zip": "pnpm build && pnpm test && pnpm package",
    "test": "node scripts/test.mjs",
    "test:prebuilt": "node scripts/test.mjs --prebuilt",
    "verify:prebuilt": "node scripts/verify-prebuilt.mjs",
    "package": "python3 scripts/package.py",
    "package:prebuilt": "python3 scripts/package.py --prebuilt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrgimael/decky-terminal.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "plugin-template",
    "steam-deck",
    "deck"
  ],
  "author": "Alex4386 <psh010209@gmail.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/vrgimael/decky-terminal/issues"
  },
  "homepage": "https://github.com/vrgimael/decky-terminal#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.10.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "@xterm/addon-attach": "^0.11.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react-icons": "^4.12.0",
    "rollup-plugin-import-css": "^3.3.1",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "packageManager": "pnpm@9.15.9"
}
